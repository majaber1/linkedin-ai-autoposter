# GitHub OAuth Configuration (Required for web dashboard login)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback
ALLOWED_GITHUB_USERS=majaber1

# Safe preview without external publishing
# Local preview only — ignored when NODE_ENV=production
DEMO_MODE=false

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# LinkedIn Configuration (Optional - for real post publishing)
# Get token from: https://www.linkedin.com/developers/apps
LINKEDIN_ACCESS_TOKEN=your_linkedin_token_here

# Your LinkedIn Profile URN
# Format: urn:li:person:123456789
LINKEDIN_PERSON_URN=urn:li:person:your_id_here
LINKEDIN_API_VERSION=202601
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/auth/linkedin/callback
LINKEDIN_TOKEN_ENCRYPTION_KEY=

# Server Port
PORT=3000

# Notes:
# - All these are optional for LOCAL TESTING in test/dummy mode
# - GitHub OAuth is recommended for dashboard authentication
# - OpenAI + LinkedIn credentials are only needed for real publishing
# - For production, use GitHub Secrets instead of .env

# Postgres — REQUIRED for Vercel/serverless, optional elsewhere.
# When unset, posts and sessions use the local filesystem + memory.
DATABASE_URL=

# Automation key for n8n / cron / CI. Long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTOMATION_API_KEY=

# MCP server: set only when pointing the MCP server at a deployed instance
# instead of this local checkout.
SIGNALPOST_URL=
